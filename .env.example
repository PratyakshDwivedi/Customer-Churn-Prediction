# Copy to `.env` and adjust as needed. All values are optional - the
# pipeline uses the defaults below when a variable is unset. Never commit
# a real `.env` (it is gitignored).

# Reproducibility
RANDOM_SEED=42
TEST_SIZE=0.2

# Synthetic dataset size
N_CUSTOMERS=6000

# Database location (relative paths resolve against the project root)
DATABASE_PATH=database/churn.db

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
